{
 "units": [
  {
   "text": "Кружка стояла не там.",
   "start": 0.08,
   "end": 1.64
  },
  {
   "text": "Ключи только у меня.",
   "start": 2.309,
   "end": 4.16
  },
  {
   "text": "И у хозяйки.",
   "start": 4.48,
   "end": 5.48
  },
  {
   "text": "Но ей под восемьдесят.",
   "start": 5.68,
   "end": 7.04
  },
  {
   "text": "Я никому не верю.",
   "start": 7.52,
   "end": 8.72
  },
  {
   "text": "Поэтому поставил камеру.",
   "start": 9.04,
   "end": 10.56
  },
  {
   "text": "В три семнадцать...",
   "start": 11.36,
   "end": 12.96
  },
  {
   "text": "из шкафа кто-то дышал.",
   "start": 13.04,
   "end": 14.64
  },
  {
   "text": "Я ветеринар.",
   "start": 15.36,
   "end": 16.32
  },
  {
   "text": "Я знаю, как дышат звери.",
   "start": 16.64,
   "end": 18.08
  },
  {
   "text": "Это был человек.",
   "start": 18.72,
   "end": 20.0
  },
  {
   "text": "Я не открыл.",
   "start": 20.32,
   "end": 21.2
  },
  {
   "text": "Сидел со скальпелем до рассвета.",
   "start": 21.52,
   "end": 23.36
  },
  {
   "text": "И уснул.",
   "start": 24.4,
   "end": 25.12
  },
  {
   "text": "Утром шкаф пустой.",
   "start": 25.737,
   "end": 26.96
  },
  {
   "text": "На полу...",
   "start": 27.36,
   "end": 28.24
  },
  {
   "text": "чужой ключ.",
   "start": 28.28,
   "end": 29.04
  },
  {
   "text": "А на записи надо мной, спящим, стоит тень.",
   "start": 29.44,
   "end": 32.4
  },
  {
   "text": "Человека в кадре нет.",
   "start": 32.8,
   "end": 34.32
  },
  {
   "text": "Он знает, когда я сплю.",
   "start": 34.72,
   "end": 36.4
  },
  {
   "text": "Значит, видит мои окна.",
   "start": 36.8,
   "end": 38.64
  },
  {
   "text": "Но откуда?",
   "start": 39.104,
   "end": 39.84
  },
  {
   "text": "У подъезда со мной заговорила только Соня.",
   "start": 40.16,
   "end": 42.56
  },
  {
   "text": "Восемь лет, сирота.",
   "start": 42.96,
   "end": 44.24
  },
  {
   "text": "Сидит тут целыми днями.",
   "start": 44.56,
   "end": 45.92
  },
  {
   "text": "Ключ подошёл.",
   "start": 46.473,
   "end": 47.52
  },
  {
   "text": "У окна стул.",
   "start": 47.92,
   "end": 48.88
  },
  {
   "text": "А напротив...",
   "start": 49.2,
   "end": 50.16
  },
  {
   "text": "моя спальня.",
   "start": 50.24,
   "end": 50.96
  },
  {
   "text": "Как на ладони.",
   "start": 51.28,
   "end": 52.16
  },
  {
   "text": "На стене десятки фото.",
   "start": 52.624,
   "end": 54.16
  },
  {
   "text": "На всех я сплю.",
   "start": 54.4,
   "end": 55.52
  },
  {
   "text": "И одно старое: хозяйка с мальчиком.",
   "start": 55.904,
   "end": 58.32
  },
  {
   "text": "Хозяйка долго молчала.",
   "start": 58.64,
   "end": 60.16
  },
  {
   "text": "Я сменил замок.",
   "start": 60.64,
   "end": 61.92
  },
  {
   "text": "Теперь ключ только у меня.",
   "start": 62.08,
   "end": 64.08
  },
  {
   "text": "Сегодня утром я открыл запись.",
   "start": 64.547,
   "end": 66.64
  },
  {
   "text": "Три семнадцать.",
   "start": 66.88,
   "end": 67.92
  },
  {
   "text": "Я встаю.",
   "start": 68.08,
   "end": 68.88
  },
  {
   "text": "Иду к двери.",
   "start": 69.168,
   "end": 70.04
  },
  {
   "text": "И открываю.",
   "start": 70.304,
   "end": 71.12
  },
  {
   "text": "Я этого не помню.",
   "start": 71.92,
   "end": 73.68
  }
 ],
