{
 "duration": 73.6,
 "units": [
  {
   "text": "Кружка стояла не там.",
   "start": 0.0,
   "end": 1.63
  },
  {
   "text": "Ключи только у меня.",
   "start": 2.269,
   "end": 3.925
  },
  {
   "text": "И у хозяйки.",
   "start": 4.496,
   "end": 5.271
  },
  {
   "text": "Но ей под восемьдесят.",
   "start": 5.603,
   "end": 6.962
  },
  {
   "text": "Я никому не верю.",
   "start": 7.414,
   "end": 8.708
  },
  {
   "text": "Поэтому поставил камеру.",
   "start": 9.066,
   "end": 10.441
  },
  {
   "text": "В три семнадцать...",
   "start": 11.385,
   "end": 12.556
  },
  {
   "text": "из шкафа кто-то дышал.",
   "start": 12.98,
   "end": 14.533
  },
  {
   "text": "Я ветеринар.",
   "start": 15.07,
   "end": 16.14
  },
  {
   "text": "Я знаю, как дышат звери.",
   "start": 16.14,
   "end": 17.988
  },
  {
   "text": "Это был человек.",
   "start": 18.662,
   "end": 19.732
  },
  {
   "text": "Я не открыл.",
   "start": 20.231,
   "end": 20.7
  },
  {
   "text": "Сидел со скальпелем до рассвета.",
   "start": 20.7,
   "end": 23.286
  },
  {
   "text": "И уснул.",
   "start": 23.704,
   "end": 25.043
  },
  {
   "text": "Утром шкаф пустой.",
   "start": 25.614,
   "end": 26.862
  },
  {
   "text": "На полу...",
   "start": 27.337,
   "end": 27.867
  },
  {
   "text": "чужой ключ.",
   "start": 28.206,
   "end": 28.996
  },
  {
   "text": "А на записи надо мной, спящим, стоит тень.",
   "start": 29.378,
   "end": 32.295
  },
  {
   "text": "Человека в кадре нет.",
   "start": 32.74,
   "end": 34.215
  },
  {
   "text": "Он знает, когда я сплю.",
   "start": 34.656,
   "end": 36.324
  },
  {
   "text": "Значит, видит мои окна.",
   "start": 36.737,
   "end": 38.55
  },
  {
   "text": "Но откуда?",
   "start": 39.063,
   "end": 39.781
  },
  {
   "text": "У подъезда со мной заговорила только Соня.",
   "start": 40.178,
   "end": 42.52
  },
  {
   "text": "Восемь лет, сирота.",
   "start": 42.876,
   "end": 44.157
  },
  {
   "text": "Сидит тут целыми днями.",
   "start": 44.49,
   "end": 45.845
  },
  {
   "text": "Ключ подошёл.",
   "start": 46.411,
   "end": 47.336
  },
  {
   "text": "У окна стул.",
   "start": 47.883,
   "end": 48.812
  },
  {
   "text": "А напротив...",
   "start": 49.196,
   "end": 49.85
  },
  {
   "text": "моя спальня.",
   "start": 50.123,
   "end": 50.919
  },
  {
   "text": "Как на ладони.",
   "start": 51.24,
   "end": 52.069
  },
  {
   "text": "На стене десятки фото.",
   "start": 52.494,
   "end": 54.149
  },
  {
   "text": "На всех я сплю.",
   "start": 54.363,
   "end": 55.453
  },
  {
   "text": "И одно старое: хозяйка с мальчиком.",
   "start": 55.868,
   "end": 58.21
  },
  {
   "text": "Хозяйка долго молчала.",
   "start": 58.622,
   "end": 60.08
  },
  {
   "text": "Я сменил замок.",
   "start": 60.536,
   "end": 61.733
  },
  {
   "text": "Теперь ключ только у меня.",
   "start": 62.037,
   "end": 63.893
  },
  {
   "text": "Сегодня утром я открыл запись.",
   "start": 64.423,
   "end": 66.451
  },
  {
   "text": "Три семнадцать.",
   "start": 66.842,
   "end": 67.716
  },
  {
   "text": "Я встаю.",
   "start": 68.042,
   "end": 68.557
  },
  {
   "text": "Иду к двери.",
   "start": 69.053,
   "end": 69.814
  },
  {
   "text": "И открываю.",
   "start": 70.238,
   "end": 70.952
  },
  {
   "text": "Я этого не помню.",
   "start": 71.74,
   "end": 73.381
  }
 ],
