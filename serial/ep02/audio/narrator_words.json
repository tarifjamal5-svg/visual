{
 "units": [
  {
   "text": "В три семнадцать ночи мама прислала голосовое.",
   "start": 0.08,
   "end": 3.24
  },
  {
   "text": "И в ту же секунду в дверь позвонили.",
   "start": 4.64,
   "end": 6.92
  },
  {
   "text": "Я посмотрела в глазок.",
   "start": 7.68,
   "end": 9.16
  },
  {
   "text": "Там стояла мама.",
   "start": 9.36,
   "end": 10.693
  },
  {
   "text": "Её пальто.",
   "start": 10.88,
   "end": 11.76
  },
  {
   "text": "Её сумка.",
   "start": 12.0,
   "end": 12.76
  },
  {
   "text": "Я написала маме: ты где?",
   "start": 13.76,
   "end": 15.76
  },
  {
   "text": "Ответ пришёл сразу: на смене до утра.",
   "start": 16.16,
   "end": 19.08
  },
  {
   "text": "Оно говорит моим голосом.",
   "start": 19.12,
   "end": 20.68
  },
  {
   "text": "Одна из них врёт.",
   "start": 21.44,
   "end": 22.96
  },
  {
   "text": "Я не открыла.",
   "start": 23.44,
   "end": 24.48
  },
  {
   "text": "Мама за дверью перестала улыбаться.",
   "start": 24.96,
   "end": 27.16
  },
  {
   "text": "И медленно пошла вверх по лестнице.",
   "start": 27.44,
   "end": 30.092
  },
  {
   "text": "А мы живём на последнем этаже.",
   "start": 30.24,
   "end": 32.572
  },
  {
   "text": "Через час пришло новое голосовое.",
   "start": 32.72,
   "end": 35.206
  },
  {
   "text": "Звонок.",
   "start": 35.28,
   "end": 36.12
  },
  {
   "text": "В глазке снова мама.",
   "start": 36.16,
   "end": 37.8
  },
  {
   "text": "Мокрая.",
   "start": 37.84,
   "end": 38.613
  },
  {
   "text": "Уставшая.",
   "start": 38.667,
   "end": 39.773
  },
  {
   "text": "Настоящая?",
   "start": 39.84,
   "end": 40.96
  }
 ],
